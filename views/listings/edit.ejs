
<% layout("/layouts/boilerplate") %>

<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br>
            <H3>Edit this listing</H3><br>
            <form method="POST" action ="/listings/<%= listing._id%>?_method=PUT" novalidate  class="needs-validation" enctype="multipart/form-data">
            

                <div class="mb-3">
                    <lable for="location" class="form-label">Title</lable>
                    <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required>
                    <div class="invalid-feedback">
                    Please provide a valid location.
                    </div>
                </div>


                <div class="mb-3">
                    <lable for="description" class="form-label">Description</lable>
                    <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">
                    Please provide a valid description.
                    </div>
                </div>
                
               <div class="mb-3 col-md-4">
                    <label for="originalImage" class="form-label">Original Image</label><br>

                    <img
                        src="<%= originalImageUrl %>"
                        alt="Original Image"
                        class="img-fluid rounded border"
                        style="max-width: 250px; height: auto;"
                    >
                </div>
                
                <div class="mb-3">
                    <lable for="image" class="form-label">Upload new Image</lable>
                    <input name="listing[image]"
                        type="file" 
                        value="<%= listing.image.url%>" 
                        class="form-control" 
                    />
                    <div class="invalid-feedback">
                    Please provide the required image.
                    </div>
                </div>
                 <div class="row">
                    <div class="mb-3 col-md-4">
                        <lable for="price" class="form-label">Price</lable>
                        <input name="listing[price]" value="<%= listing.price %>"  type="number" class="form-control" required>
                        <div class="invalid-feedback">
                        Please provide a valid price.
                        </div>
                    </div>
                    
                    <div class="mb-3 col-md-8">
                        <lable for="location" class="form-label">Location</lable>
                        <input name="listing[location]"value="<%= listing.location %>"  class="form-control" required>
                        <div class="invalid-feedback">
                        Please provide a valid location.
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <lable for="country" class="form-label">Country</lable>
                    <input name="listing[country]" value="<%= listing.country %>"  type="text" class="form-control" required>
                    <div class="invalid-feedback">
                    Please provide a valid country.
                    </div>
                </div>
                <div input-group mb-3>
                <label for="category input-group-text" class="form-label">Category</label>
                    <select name="listing[category]" id="category" class="form-select">

                    <option value="Trending"
                    <%= listing.category==="Trending" ? "selected" : "" %>>
                    Trending
                    </option>
                    <option value="Arctic"
                    <%= listing.category==="Arctic" ? "selected" : "" %>>
                    Arctic
                    </option>
                    <option value="City"
                    <%= listing.category==="City" ? "selected" : "" %>>
                    City
                    </option>

                    <option value="Rooms"
                    <%= listing.category==="Rooms" ? "selected" : "" %>>
                    Rooms
                    </option>
                    <option value="Beach"
                    <%= listing.category==="Beach" ? "selected" : "" %>>
                    Beach
                    </option>

                    <option value="Beachfront"
                    <%= listing.category==="Beachfront" ? "selected" : "" %>>
                    Beachfront
                    </option>

                    <option value="Mountains"
                    <%= listing.category==="Mountains" ? "selected" : "" %>>
                    Mountains
                    </option>
                    <option value="Hiking"
                    <%= listing.category==="Hiking" ? "selected" : "" %>>
                    Hiking
                    </option>

                    <option value="Camping"
                    <%= listing.category==="Camping" ? "selected" : "" %>>
                    Camping
                    </option>

                    <option value="Pools"
                    <%= listing.category==="Pools" ? "selected" : "" %>>
                    Pools
                    </option>
                    <option value="Forest"
                    <%= listing.category==="Forest" ? "selected" : "" %>>
                    Forest
                    </option>

                    <option value="Apartments"
                    <%= listing.category==="Apartments" ? "selected" : "" %>>
                    Apartments
                    </option>
                    <option value="HotTub"
                    <%= listing.category==="HotTub" ? "selected" : "" %>>
                    HotTub
                    </option>
                    <option value="Gym"
                    <%= listing.category==="Gym" ? "selected" : "" %>>
                    Gym
                    </option>
                    <option value="Spa"
                    <%= listing.category==="Spa" ? "selected" : "" %>>
                    Spa
                    </option>
                    <option value="Kitchen"
                    <%= listing.category==="Kitchen" ? "selected" : "" %>>
                    Kitchen
                    </option>
                    <option value="WiFi"
                    <%= listing.category==="WiFi" ? "selected" : "" %>>
                    WiFi
                    </option>
                    <option value="PetFriendly"
                    <%= listing.category==="PetFriendly" ? "selected" : "" %>>
                    PetFriendly
                    </option>
                    <option value="Heritage"
                    <%= listing.category==="Heritage" ? "selected" : "" %>>
                    Heritage
                    </option>
                    <option value="Villas"
                    <%= listing.category==="Villas" ? "selected" : "" %>>
                    Villas
                    </option>

                    </select>
                </div>
                <!-- <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>
                    Trending
                </option> -->
            <button class="btn btn-outline-primary mt-3">Edit</button>
            </form>
            <br>
        </div>
    </div>
    <script src="/js/script.js"></script>
</body>
