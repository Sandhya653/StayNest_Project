
<% layout("/layouts/boilerplate") %>
<body>
    <br>
    <style>
        #filters {
            margin-top: 1rem;
            display: flex;
            flex-wrap: nowrap;
            gap: 2rem;
            overflow-x: auto;
            padding: 1rem 0;
            scrollbar-width: none; /* Firefox */
        }
        #filters::-webkit-scrollbar {
            display: none; /* Chrome */
        }

        .filter {
            text-align: center;
            color: black;
            flex-shrink: 0;
            opacity: 0.7;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .filter:hover {
            opacity: 1;
            cursor: pointer;
            transform: translateY(-3px);
        }
        .tax-info{
            display: none;
        }
        .tax-toggle{
            border: 1px solid black;
            border-radius: 1rem;
            height: 1 rem;
            padding: 1rem;
            display: flex;
            align-items: center;
        }
    </style>

    
    <div id="filters">

        <a href="/listings?category=Trending" class="filter">
            <div><i class="fa-solid fa-fire" style="color: blue;"></i></div>
            <p>Trending</p>
        </a>
        <a href="/listings?category=Rooms" class="filter">
            <i class="fa-solid fa-bed" style="color: blue;"></i>
            <p>Rooms</p>
        </a>

        <a href="/listings?category=Beach" class="filter">
            <div><i class="fa-solid fa-water" style="color: blue;"></i></div>
            <p>Beach</p>
        </a>

        <a href="/listings?category=Mountains" class="filter">
            <div><i class="fa-solid fa-mountain" style="color: blue;"></i></div>
            <p>Mountains</p>
        </a>

        <a href="/listings?category=City" class="filter">
            <div><i class="fa-solid fa-city" style="color: blue;"></i></div>
            <p>City</p>
        </a>

        <a href="/listings?category=Arctic" class="filter">
            <div><i class="fa-solid fa-snowflake" style="color: blue;"></i></div>
            <p>Arctic</p>
        </a>

        <a href="/listings?category=Forest" class="filter">
            <div><i class="fa-solid fa-tree" style="color: blue;"></i></div>
            <p>Forest</p>
        </a>

        <a href="/listings?category=Beachfront" class="filter">
            <div><i class="fa-solid fa-umbrella-beach" style="color: blue;"></i></div>
            <p>Beachfront</p>
        </a>

        <a href="/listings?category=Pools" class="filter">
            <div><i class="fa-solid fa-water-ladder" style="color: blue;"></i></div>
            <p>Pools</p>
        </a>

        <a href="/listings?category=Camping" class="filter">
            <div><i class="fa-solid fa-campground" style="color: blue;"></i></div>
            <p>Camping</p>
        </a>

        <a href="/listings?category=Hiking" class="filter">
            <div><i class="fa-solid fa-person-hiking" style="color: blue;"></i></div>
            <p>Hiking</p>
        </a>

        <a href="/listings?category=Apartments" class="filter">
            <div><i class="fa-solid fa-building" style="color: blue;"></i></div>
            <p>Apartments</p>
        </a>

        <a href="/listings?category=Villas" class="filter">
            <div><i class="fa-solid fa-house" style="color: blue;"></i></div>
            <p>Villas</p>
        </a>

        <a href="/listings?category=Heritage" class="filter">
            <div><i class="fa-solid fa-landmark" style="color: blue;"></i></div>
            <p>Heritage</p>
        </a>

        <a href="/listings?category=PetFriendly" class="filter">
            <div><i class="fa-solid fa-paw" style="color: blue;"></i></div>
            <p>Pet Friendly</p>
        </a>

        <a href="/listings?category=WiFi" class="filter">
            <div><i class="fa-solid fa-wifi" style="color: blue;"></i></div>
            <p>Wi-Fi</p>
        </a>

        <a href="/listings?category=Kitchen" class="filter">
            <div><i class="fa-solid fa-kitchen-set" style="color: blue;"></i></div>
            <p>Kitchen</p>
        </a>

        <a href="/listings?category=Spa" class="filter">
            <div><i class="fa-solid fa-spa" style="color: blue;"></i></div>
            <p>Spa</p>
        </a>

        <a href="/listings?category=Gym" class="filter">
            <div><i class="fa-solid fa-dumbbell" style="color: blue;"></i></div>
            <p>Gym</p>
        </a>

        <a href="/listings?category=HotTub" class="filter">
            <div><i class="fa-solid fa-hot-tub-person" style="color: blue;"></i></div>
            <p>Hot Tub</p>
        </a>
    </div>
    <div class="tax-toggle">
    <div class="form-check form-switch form-check-reverse">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">
            Display Total after Taxes
        </label>
    </div>
</div>

   <br>
    <div class="row row-cols-lg-4 reo-cols-md-3 row-cols-sm-2 mt-3">
        
        <% for(let listing of allListings){%>
        <a href="/listings/<%= listing._id %>" class="listing-link">
        <!-- <div class="card col" style="width: 20rem;"> card se listing-card -->
        <div class="card col "  style="width: 20rem">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20 rem" />
            <div class="card-img-overlay">abcd</div>
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b>
                    </br>
                    &#8377; <%= Number(listing.price)%> /night
                    <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                </p>
            </div>            
        </div>
        </a>
        <%}%>
        <br>
    </div>
  <script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    let taxInfo = document.getElementsByClassName("tax-info");

    taxSwitch.addEventListener("change", function () {
        for (let info of taxInfo) {
            if (taxSwitch.checked) {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
</script>
</body>
